{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Jarvis - a local-first, self-hosted AI assistant with a Flutter client and a TypeScript server.",
  "private": true,
  "scripts": {
    "test": "tsx --test src/backend/tests/*.test.ts",
    "test:app": "cd src/app && flutter test",
    "analyze:app": "cd src/app && flutter analyze",
    "start": "tsx src/backend/index.ts",
    "dev": "tsx watch src/backend/index.ts",
    "start:managed": "tsx src/backend/ProcessManager.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "assistant",
    "local-first",
    "self-hosted",
    "ollama",
    "flutter",
    "typescript"
  ],
  "author": "Jarvis contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiadjmc/jarvis.git"
  },
  "bugs": {
    "url": "https://github.com/santiadjmc/jarvis/issues"
  },
  "homepage": "https://github.com/santiadjmc/jarvis#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "dependencies": {
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "figlet": "^1.12.0",
    "googleapis": "^183.0.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "nodemailer": "^10.0.15",
    "puppeteer": "^25.12.0",
    "redis": "^6.2.1",
    "undici": "^7.30.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.12.0": true
  }
}
