# HTTP Server
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
API_KEY_PREFIX=jvs
JARVIS_MASTER_KEY=jvs_change_me_this_is_the_admin_key

# AI backend (any OpenAI-compatible server: Ollama, LM Studio, vLLM, llama.cpp
# server, OpenAI itself, OpenRouter, etc). The base URL must point at the
# "/v1" root that exposes /v1/chat/completions.
# Defaults to a local Ollama install, which serves an OpenAI-compatible API at
# http://127.0.0.1:11434/v1 out of the box.
AI_BASE_URL=http://127.0.0.1:11434/v1
# Bearer token sent as "Authorization: Bearer <key>". Ollama ignores it, so
# any placeholder works locally; set a real key for hosted providers.
AI_API_KEY=ollama
# Two-tier routing: AI_MODEL is the always-resident fast model for routine
# chat; AI_DEEP_MODEL is used for reasoning-heavy tasks (loaded on demand when
# talking to Ollama). Defaults to the same lightweight model for both tiers.
# JARVIS_ROUTING=auto | always_fast | always_deep
AI_MODEL=llama3.2
AI_DEEP_MODEL=llama3.2
JARVIS_ROUTING=auto
AI_TIMEOUT=120000

# Embeddings always go through Ollama's native API (used for the local facts
# memory store). Only relevant when AI_BASE_URL points at a real Ollama
# instance; otherwise memory search silently falls back to substring search.
# Tip: restart `ollama serve` with OLLAMA_MAX_LOADED_MODELS=1 so the embedding
# model does not evict the chat model from GPU VRAM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Agent tools
# JARVIS_TOOLS=* (all) | comma-separated names to allow | -name,-name to allow
# everything except those | none
# The browser_* tools need Chrome's runtime libraries installed on this host
# (see https://pptr.dev/troubleshooting); exclude them here if unavailable,
# e.g. JARVIS_TOOLS=-browser_open,-browser_click,-browser_type,-browser_screenshot,-browser_extract_text,-browser_close,-browser_list_pages
JARVIS_TOOLS=*
# Device tools run on the connected client (phone/desktop). $ == all | comma-separated tool names | none
# Device tools are only advertised to the model while a device with the matching capability is online.
JARVIS_DEVICE_TOOLS=*
JARVIS_MAX_TOOL_TURNS=6
# 1 auto-approves risky tools (shell, file writes, destructive ops) without asking
JARVIS_AUTO_APPROVE=0
# SearXNG instance used by web_search (enable "formats: [json]" in its settings)
JARVIS_SEARXNG_URL=http://127.0.0.1:8080
# Optional override for Jarvis data files (facts memory etc); defaults to ~/.local/share/jarvis
JARVIS_DATA_DIR=

# Context management
# Fraction of model context that triggers auto-summarization compaction (0.55)
JARVIS_COMPACT_THRESHOLD=0.55
# Minimum number of new messages between compactions (rate limit)
JARVIS_COMPACT_BATCH=10
# Auto-recall relevant memories from the facts store at the start of each run
JARVIS_MEMORY_AUTOLOAD=1
JARVIS_MEMORY_TOP_K=3
JARVIS_MEMORY_MIN_SCORE=0.4

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# TTS
TTS_ENABLED=false
TTS_ENGINE=piper
TTS_VOICE=en_US-ryan-high
TTS_SPEED=1.0
# Path to the piper binary when not on PATH (e.g. ~/.local/share/piper-venv/bin/piper)
TTS_PIPER_BIN=
# Directory containing <voice>.onnx models; defaults to ~/.local/share/jarvis/piper
TTS_MODEL_DIR=

# Google account access (Gmail, Calendar, Drive, YouTube)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Web application"), enable the Gmail/Calendar/Drive/YouTube Data APIs,
# add yourself as a test user on the OAuth consent screen, and set the
# redirect URI there to exactly match GOOGLE_REDIRECT_URI below.
# Unverified ("Testing") apps re-issue refresh tokens every 7 days; Jarvis
# will proactively tell you when it's time to reconnect.
# Visit http://<this server's host:port>/oauth/google/start to connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Email (send_email tool)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Process Manager
PM_MAX_RESTARTS=5
PM_RESTART_DELAY=3000
PM_HANG_TIMEOUT=0
PM_WEBHOOK_URL=
