# HTTP Server
PORT=3000
HOST=0.0.0.0
# Set to 1 when Jarvis sits behind a reverse proxy (nginx, Caddy, Traefik...).
# A proxy on the same host makes every request look like it comes from
# 127.0.0.1, so with this on Jarvis never trusts "loopback" alone: starting the
# Google connect flow always needs the one-time token from the app. Requests
# carrying X-Forwarded-For / Forwarded / X-Real-IP headers are treated the
# same way even when this is off.
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
API_KEY_PREFIX=jvs
# Set this to a long random secret (e.g. `openssl rand -base64 48`). The server
# refuses to start with the placeholder below, since it would be a publicly
# known admin key.
JARVIS_MASTER_KEY=jvs_change_me_this_is_the_admin_key
# WebSocket clients authenticate with an "Authorization: Bearer <key>" header on
# the /ws upgrade. The old ?key= query parameter is no longer accepted.

# AI backend (any OpenAI-compatible server: Ollama, LM Studio, vLLM, llama.cpp
# server, OpenAI itself, OpenRouter, etc). The base URL must point at the
# "/v1" root that exposes /v1/chat/completions.
# Defaults to a local Ollama install, which serves an OpenAI-compatible API at
# http://127.0.0.1:11434/v1 out of the box.
AI_BASE_URL=http://127.0.0.1:11434/v1
# Bearer token sent as "Authorization: Bearer <key>". Ollama ignores it, so
# any placeholder works locally; set a real key for hosted providers.
AI_API_KEY=ollama
# Two-tier routing: AI_MODEL is the always-resident fast model for routine
# chat; AI_DEEP_MODEL is used for reasoning-heavy tasks (loaded on demand when
# talking to Ollama). Defaults to the same lightweight model for both tiers.
# JARVIS_ROUTING=auto | always_fast | always_deep
AI_MODEL=llama3.2
AI_DEEP_MODEL=llama3.2
JARVIS_ROUTING=auto
AI_TIMEOUT=120000

# Embeddings always go through Ollama's native API (used for the local facts
# memory store). Only relevant when AI_BASE_URL points at a real Ollama
# instance; otherwise memory search silently falls back to substring search.
# Tip: restart `ollama serve` with OLLAMA_MAX_LOADED_MODELS=1 so the embedding
# model does not evict the chat model from GPU VRAM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Agent tools
# JARVIS_TOOLS=* (all) | comma-separated names to allow | -name,-name to allow
# everything except those | none
# The browser_* tools need Chrome's runtime libraries installed on this host
# (see https://pptr.dev/troubleshooting); exclude them here if unavailable,
# e.g. JARVIS_TOOLS=-browser_open,-browser_click,-browser_type,-browser_screenshot,-browser_extract_text,-browser_close,-browser_list_pages
JARVIS_TOOLS=*
# Device tools run on the connected client (phone/desktop). $ == all | comma-separated tool names | none
# Device tools are only advertised to the model while a device with the matching capability is online.
JARVIS_DEVICE_TOOLS=*
# Max LLM<->tool round-trips per response, shared by live chat, proactive
# tasks, and subagents. Blank/0 (default) means no limit - rely on the
# Stop button (live chat) for anything that runs away. Set a positive
# number to cap it again.
JARVIS_MAX_TOOL_TURNS=
# 1 auto-approves risky tools (shell, file writes, destructive ops) without asking
JARVIS_AUTO_APPROVE=0
# SearXNG instance used by web_search (enable "formats: [json]" in its settings)
JARVIS_SEARXNG_URL=http://127.0.0.1:8080
# By default the network tools refuse loopback, private, link-local and other
# reserved addresses: fetch_url, http_request (including every redirect hop),
# check_port, browser_open and every page/subresource the headless browser
# loads. Set to 1 only if you understand the SSRF risk. ping_host is a LAN
# diagnostic and may always reach private and loopback hosts.
JARVIS_FETCH_ALLOW_PRIVATE=0
# The headless browser keeps Chromium's sandbox on unless Jarvis runs as root.
# Set to 1 only on hosts without user namespaces where Chromium can't sandbox.
JARVIS_BROWSER_NO_SANDBOX=0
# Optional override for Jarvis data files (facts memory etc); defaults to ~/.local/share/jarvis
JARVIS_DATA_DIR=
# Comma-separated roots the approval-free file tools (read_file, list_dir,
# search_files, grep_files) may read. Defaults to $HOME, the working directory
# and the temp dir. Secrets (.env, ~/.ssh, keys, JARVIS_DATA_DIR, /proc) are
# always refused. Use "/" to allow the whole filesystem.
JARVIS_FS_ROOTS=

# Abort a chat request after this many ms with no progress (tokens, tool
# activity). Must exceed the 60s approval and 90s device-tool waits.
JARVIS_STREAM_IDLE_TIMEOUT_MS=180000

# Chat messages on the same conversation run one at a time, in arrival order.
# This many extra messages may wait behind the running one; further messages
# get a CONVERSATION_BUSY error. 0 rejects any message while a reply is running.
JARVIS_CHAT_QUEUE_MAX=5

# Prompt-injection guardrails. A conversation that has read external content
# (mail, web pages, search, Drive, browser, device screen/clipboard) is
# "tainted". No approval prompts are added; instead:
# - schedule_task from a tainted conversation creates an "external" task: at
#   most JARVIS_TAINTED_TASK_MAX of them, repeating no more often than
#   JARVIS_TAINTED_TASK_MIN_INTERVAL_MIN minutes (they don't expire);
# - delegate_task: at most JARVIS_TAINTED_SUBAGENT_MAX such subagents at once;
# - both run with only JARVIS_TAINTED_RUN_TOOLS (offline, read-only tools);
# - remember stores the fact as untrusted; it is still loaded into later
#   prompts, but quoted and labelled as a note, not an instruction.
# Every guarded action is logged as "Provenance guard: ...". Set
# JARVIS_PROVENANCE_GUARDS=0 to turn the guardrails off (taint is still logged).
JARVIS_PROVENANCE_GUARDS=1
JARVIS_TAINTED_TASK_MAX=3
JARVIS_TAINTED_TASK_MIN_INTERVAL_MIN=60
JARVIS_TAINTED_SUBAGENT_MAX=1
JARVIS_TAINTED_RUN_TOOLS=get_time,calculate,convert_units,generate_uuid,get_weather,list_events,list_scheduled_tasks,recall
# Outbound guardrails in a tainted conversation: a fetch_url, http_request,
# browser_open, device_open_url or browser_type call is blocked only when what
# it sends (URL, body, header values, typed text) contains a secret-looking
# value or text read from local files/git/clipboard/memory (also
# base64/hex/URI-encoded). Any HTTP method, body or header is fine otherwise.
# Short, low-entropy or ID-like overlaps (commit SHAs, cursors, page tokens),
# text the user typed and links from the user's messages or files don't count.
# When the user approves a call (e.g. http_request), only secrets still block
# it. URLs and browser_type text longer than this many characters are blocked.
# Secret-looking strings (keys, tokens, PEM private keys, KEY=VALUE secrets,
# values of sensitive env vars) are redacted from tool results for the model.
JARVIS_TAINTED_MAX_OUTBOUND_CHARS=4096

# Context management
# Effective context window of the LLM backend (e.g. Ollama's num_ctx, often
# 2048-8192 unless the Modelfile raises it). Compaction budgets are capped to
# this so history is summarized before the backend silently truncates it.
JARVIS_NUM_CTX=
# Fraction of model context that triggers auto-summarization compaction (0.55)
JARVIS_COMPACT_THRESHOLD=0.55
# Minimum number of new messages between compactions (rate limit)
JARVIS_COMPACT_BATCH=10
# Auto-recall relevant memories from the facts store at the start of each run
JARVIS_MEMORY_AUTOLOAD=1
JARVIS_MEMORY_TOP_K=3
JARVIS_MEMORY_MIN_SCORE=0.4

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# TTS
TTS_ENABLED=false
TTS_ENGINE=piper
TTS_VOICE=en_US-ryan-high
TTS_SPEED=1.0
# Path to the piper binary when not on PATH (e.g. ~/.local/share/piper-venv/bin/piper)
TTS_PIPER_BIN=
# Directory containing <voice>.onnx models; defaults to ~/.local/share/jarvis/piper
TTS_MODEL_DIR=

# Google account access (Gmail, Calendar, Drive, YouTube)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Web application"), enable the Gmail/Calendar/Drive/YouTube Data APIs,
# add yourself as a test user on the OAuth consent screen, and set the
# redirect URI there to exactly match GOOGLE_REDIRECT_URI below.
# Unverified ("Testing") apps re-issue refresh tokens every 7 days; Jarvis
# will proactively tell you when it's time to reconnect (using Google's
# refresh_token_expires_in, or GOOGLE_REFRESH_TOKEN_DAYS if set, e.g. 7).
GOOGLE_REFRESH_TOKEN_DAYS=
# To connect, tap "Connect Google" in the Jarvis app (it fetches a one-time
# sign-in link via the "googleConnectUrl" config key). Opening
# /oauth/google/start directly only works from a browser on this machine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Email (send_email tool)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Process Manager
PM_MAX_RESTARTS=5
PM_RESTART_DELAY=3000
PM_HANG_TIMEOUT=0
PM_WEBHOOK_URL=
