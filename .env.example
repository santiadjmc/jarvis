# HTTP Server
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
API_KEY_PREFIX=jvs
JARVIS_MASTER_KEY=jvs_change_me_this_is_the_admin_key

# Ollama
# Tip: restart `ollama serve` with OLLAMA_MAX_LOADED_MODELS=1 so the embedding
# model does not evict the chat model from GPU VRAM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Two-tier routing: OLLAMA_DEFAULT_MODEL is the always-resident fast model for
# routine chat; OLLAMA_DEEP_MODEL is loaded on-demand for reasoning-heavy tasks.
# JARVIS_ROUTING=auto | always_fast | always_deep
# Default and deep are the same model unless you set different tags.
OLLAMA_DEFAULT_MODEL=mistral:latest
OLLAMA_DEEP_MODEL=mistral:latest
JARVIS_ROUTING=auto
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120000

# Agent tools
# JARVIS_TOOLS=* (all) | comma-separated names | none
JARVIS_TOOLS=*
# Device tools run on the connected client (phone/desktop). $ == all | comma-separated tool names | none
# Device tools are only advertised to the model while a device with the matching capability is online.
JARVIS_DEVICE_TOOLS=*
JARVIS_MAX_TOOL_TURNS=6
# 1 auto-approves risky tools (shell, file writes, destructive ops) without asking
JARVIS_AUTO_APPROVE=0
# SearXNG instance used by web_search (enable "formats: [json]" in its settings)
JARVIS_SEARXNG_URL=http://127.0.0.1:8080
# Optional override for Jarvis data files (facts memory etc); defaults to ~/.local/share/jarvis
JARVIS_DATA_DIR=

# Context management
# Fraction of model context that triggers auto-summarization compaction (0.55)
JARVIS_COMPACT_THRESHOLD=0.55
# Minimum number of new messages between compactions (rate limit)
JARVIS_COMPACT_BATCH=10
# Auto-recall relevant memories from the facts store at the start of each run
JARVIS_MEMORY_AUTOLOAD=1
JARVIS_MEMORY_TOP_K=3
JARVIS_MEMORY_MIN_SCORE=0.4

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jarvis

# TTS
TTS_ENABLED=false
TTS_ENGINE=piper
TTS_VOICE=en_US-ryan-high
TTS_SPEED=1.0
# Path to the piper binary when not on PATH (e.g. ~/.local/share/piper-venv/bin/piper)
TTS_PIPER_BIN=
# Directory containing <voice>.onnx models; defaults to ~/.local/share/jarvis/piper
TTS_MODEL_DIR=

# Process Manager
PM_MAX_RESTARTS=5
PM_RESTART_DELAY=3000
PM_HANG_TIMEOUT=0
PM_WEBHOOK_URL=
